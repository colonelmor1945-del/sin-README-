# Optional. Without it the app runs on the deterministic mock AI provider,
# so every screen still works offline. Set it to get real Claude responses.
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the assistant, plan generator and creator lab.
ANTHROPIC_MODEL=claude-opus-5

# Optional but recommended. Lets the video panel search all of YouTube by
# topic. Without it the panel tries the official Rockstar channel feed (down
# for everyone since February 2026) and then a short list of official
# trailers checked through oEmbed, and labels which one it is showing.
# Get one from https://console.cloud.google.com (YouTube Data API v3).
YOUTUBE_API_KEY=

# Optional. A permanent invite to the Discord server, as a link or a bare code.
# This alone turns on the live member and online counts: no bot, no token,
# nothing to switch on in the server. Make the invite "never expire".
NEXT_PUBLIC_DISCORD_INVITE=

# Optional, and only used when there is no invite above. Reads the server
# widget instead, which the owner must switch on in Server Settings, Widget.
DISCORD_GUILD_ID=

# Optional. Enables "Continue with Google" on the sign-in screens.
# Create an OAuth client at https://console.cloud.google.com and add
# <APP_URL>/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required in production. The public origin, used to build OAuth redirects.
APP_URL=http://localhost:3000

# Optional. The Reddit panel works without these, from the public RSS feed,
# but that has no scores or comment counts and a tiny anonymous rate limit.
# With a free "script" app from https://www.reddit.com/prefs/apps you get both.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Postgres. Without it the app runs on an in-memory store that loses every
# account on restart, and it refuses to start at all in production.
# Apply src/lib/db/schema.sql once, then set this.
DATABASE_URL=

# Optional. Links a Spotify playlist into the app. Just the playlist id,
# the part after /playlist/ in the share URL.
NEXT_PUBLIC_SPOTIFY_PLAYLIST_ID=

# Required for scheduled ingestion. Point a cron at
# GET /api/cron/ingest with an Authorization: Bearer <secret> header.
# Without it the endpoint refuses to run rather than defaulting to open.
CRON_SECRET=

# Set to 1 to run the dev server on a real PostgreSQL stored in .data/postgres
# instead of the in-memory store, so accounts survive a restart. Nothing to
# install. `npm run dev:db` sets it for you. Ignored in production.
LOCAL_DB=

# Set to 0 to stop the development account (dev@moneylab.local) being created.
SEED_DEV_ACCOUNT=
