# Optional. Without it the app runs on the deterministic mock AI provider,
# so every screen still works offline. Set it to get real Claude responses.
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the assistant, plan generator and creator lab.
ANTHROPIC_MODEL=claude-opus-5

# Optional. Enables the Community feed video panel. Without it that panel says
# so rather than showing placeholder videos.
# Get one from https://console.cloud.google.com (YouTube Data API v3).
YOUTUBE_API_KEY=

# Optional. Public invite for the Discord widget in the footer.
NEXT_PUBLIC_DISCORD_INVITE=

# Optional. Enables the live Discord member count. The server owner must
# also switch the widget on in Server Settings, Widget.
DISCORD_GUILD_ID=

# Optional. Enables "Continue with Google" on the sign-in screens.
# Create an OAuth client at https://console.cloud.google.com and add
# <APP_URL>/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required in production. The public origin, used to build OAuth redirects.
APP_URL=http://localhost:3000

# Optional. Enables the Reddit panel in the community feed. Register a
# "script" app at https://www.reddit.com/prefs/apps. Free.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
